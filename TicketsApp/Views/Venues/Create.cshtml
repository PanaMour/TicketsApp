@model TicketsApp.Models.Venue

@{
    ViewData["Title"] = "Create Venue";
}

<h1>Create Venue</h1>

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header card-header-custom">
            <h4 class="mb-0">Venue Details</h4>
        </div>
        <div class="card-body">
            <form id="venueForm" asp-action="Create" enctype="multipart/form-data" class="form-horizontal">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="VenueName" class="control-label">Venue Name</label>
                    <input asp-for="VenueName" class="form-control" placeholder="Enter venue name" />
                    <span asp-validation-for="VenueName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Location" class="control-label">Location</label>
                    <input asp-for="Location" class="form-control" placeholder="Enter location" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Capacity" class="control-label">Capacity</label>
                    <input asp-for="Capacity" type="number" class="form-control" placeholder="Enter capacity" />
                    <span asp-validation-for="Capacity" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label for="venueImage" class="control-label">Venue Image</label>
                    <input type="file" id="venueImage" name="VenueImage" class="form-control" />
                </div>

                <div class="form-group">
                    <label for="tokenTimer" class="control-label">SAS Token Expires In:</label>
                    <span id="tokenTimer">0:30</span>
                </div>

                <br />
                <div class="form-group text-center">
                    <button type="button" id="submitBtn" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
        <div class="card-footer text-center">
            <a asp-action="Index" class="btn btn-link">Back to List</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        let sasTokenExpiryTime = 30;
        function updateTimer() {
            const timerElement = document.getElementById('tokenTimer');
            const minutes = Math.floor(sasTokenExpiryTime / 60);
            const seconds = sasTokenExpiryTime % 60;
            timerElement.textContent = `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;

            if (sasTokenExpiryTime > 0) {
                sasTokenExpiryTime--;
            } else {
                clearInterval(timerInterval);
                alert('The SAS token has expired. Please refresh the page to generate a new one.');
            }
        }
        async function fetchSasTokenForFileUpload(fileName) {
            try {
                const response = await fetch(`/Venues/GetUploadSasToken?blobName=${fileName}`);
                const data = await response.json();

                const sasTokenUrl = data.sasToken;
                console.log('SAS Token URL:', sasTokenUrl);

                return sasTokenUrl;
            } catch (error) {
                console.error('Error fetching SAS token:', error);
                return null;
            }
        }
        let timerInterval = setInterval(updateTimer, 1000);
        document.getElementById("venueImage").addEventListener("change", async function () {
            const fileInput = document.getElementById('venueImage');
            const file = fileInput.files[0];

            if (file) {
                console.log(`File selected: ${file.name}`);

                const sasTokenUrl = await fetchSasTokenForFileUpload(file.name);

                if (sasTokenUrl) {
                    document.getElementById("submitBtn").addEventListener("click", async function () {

                        try {
                            const uploadResponse = await fetch(sasTokenUrl, {
                                method: 'PUT',
                                headers: {
                                    'x-ms-blob-type': 'BlockBlob'
                                },
                                body: file
                            });

                            if (uploadResponse.ok) {
                                console.log('File uploaded successfully');

                                const fileUrl = sasTokenUrl.split("?")[0];

                                const imageUrlInput = document.createElement('input');
                                imageUrlInput.type = 'hidden';
                                imageUrlInput.name = 'imageUrl';
                                imageUrlInput.value = fileUrl;
                                document.getElementById('venueForm').appendChild(imageUrlInput);

                                const form = document.getElementById('venueForm');
                                form.submit();
                            } else {
                                console.error('Failed to upload file');
                            }
                        } catch (error) {
                            console.error('Error during upload', error);
                        }
                    });
                }
            }
        });

    </script>
}

<style>
    .card-header-custom {
        background-color: #0FC2C0;
        color: #023535;
    }

    .btn-primary {
        background-color: #0CABA8;
        border-color: #008F8C;
        color: #ffffff;
    }

        .btn-primary:hover {
            background-color: #008F8C;
            border-color: #007B8A;
        }

    .btn-link {
        color: #0CABA8;
    }

        .btn-link:hover {
            color: #008F8C;
        }

    .container {
        max-width: 600px;
    }
</style>
